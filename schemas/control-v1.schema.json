{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earshot.invalid/schemas/control-v1.schema.json",
  "title": "Earshot relay workspace control contract v1",
  "description": "Runtime validation also enforces unique IDs and channel names, same-workspace references, valid endpoints, and the configured writer binding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "workspace", "channels", "agents", "devices"],
  "properties": {
    "version": {"const": "control.v1"},
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "endpoint", "bucket", "region"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "endpoint": {"type": "string", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[A-Za-z0-9.\\[\\]:-]+(/[A-Za-z0-9._~/-]*)?(?![\\s\\S])"},
        "bucket": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,254}(?![\\s\\S])"},
        "region": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}(?![\\s\\S])"}
      }
    },
    "channels": {
      "type": "array", "items": {"$ref": "#/$defs/channel"}
    },
    "agents": {
      "type": "array", "items": {"$ref": "#/$defs/entity"}
    },
    "devices": {
      "type": "array", "items": {"$ref": "#/$defs/entity"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])"},
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "workspace_id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "workspace_id": {"$ref": "#/$defs/id"}}
    },
    "channel": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "workspace_id", "name"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}(?![\\s\\S])", "not": {"const": "replies"}}
      }
    }
  }
}
