# Copy to .env and fill in. Never commit .env. Every value below is a placeholder or empty, and the relay refuses
# to start until the empty tokens are set and the replace-me values are replaced.

# --- Your bucket (any S3-compatible service) ---------------------------------------------------------
EARSHOT_S3_ENDPOINT=https://s3.example.com
EARSHOT_BUCKET=earshot
EARSHOT_REGION=us-east-1
# A key that may PutObject (only) under earshot/<channel>/. See docs/permissions.md.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# --- API token for callers (32+ characters). Generate one with any of:
#   docker run --rm ghcr.io/automaticai-io/earshot-relay token
#   uv run earshot-relay token                     (from a checkout)
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
EARSHOT_RELAY_TOKEN=

# --- Receipts (optional). A second, different token that goes into the phone's beacon URL ------------
# EARSHOT_RELAY_BEACON_TOKEN=
# Public https URL of this relay, used to print the beacon URL for the app
# EARSHOT_RELAY_PUBLIC_URL=https://earshot-relay.example.com
# Serve only the beacon endpoint on a second port (then also publish 127.0.0.1:8081:8081, see docs/tunnels.md)
# EARSHOT_RELAY_BEACON_PORT=8081

# --- Channels -------------------------------------------------------------------------------------
# The alarm channel is LOUD and is not sendable unless you list it here. It plays a siren, then the message on the
# phone's alarm stream at high volume, also during a phone call (unless the app's "Alarms can interrupt calls" is
# off), where the other party may hear it. Do Not Disturb set to "Total silence", an Android refusal, a stopped
# service, a powered-off phone, battery restrictions or no network can still silence it. It is not an emergency or
# life-safety service. The default channel can never be alarm.
# EARSHOT_RELAY_CHANNELS=phone,alarm
# EARSHOT_RELAY_DEFAULT_CHANNEL=phone

# --- Server-side speech (optional): any OpenAI-compatible /audio/speech endpoint ---------------------
# EARSHOT_RELAY_TTS_URL=https://tts.example.com/v1
# EARSHOT_RELAY_TTS_MODEL=replace-me
# EARSHOT_RELAY_TTS_VOICE=replace-me
# EARSHOT_RELAY_TTS_API_KEY=
# EARSHOT_RELAY_DEFAULT_SPEECH=device
